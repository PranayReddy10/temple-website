APP_NAME="Temple Passport"
# In production set APP_ENV=production and APP_DEBUG=false.
# With APP_DEBUG=true, any error page prints stack traces, file paths and
# environment values to whoever triggered it.
APP_ENV=local
# Generated by `php artisan key:generate`. The app returns a 500 without it.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Set when the site sits behind Cloudflare or any TLS-terminating proxy,
# otherwise Laravel generates http:// URLs on an https domain.
# Use * behind Cloudflare, or a comma-separated list of proxy IPs.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostinger shared hosting provides MySQL. Create the database and user in
# hPanel, then paste the exact names here (Hostinger prefixes both, e.g. u123456789_temple).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Media storage (DigitalOcean Spaces) --------------------------------
# Temple photos live in object storage, not on the web host: a shared plan has
# a small disk quota and no CDN. Leave MEDIA_DISK as 'public' for local work
# and CI — neither needs a DigitalOcean account. Set it to 'spaces' in
# production once the values below are filled in.
MEDIA_DISK=public

# Region slug, e.g. blr1 (Bangalore), sgp1 (Singapore), nyc3.
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
# Origin endpoint: https://<region>.digitaloceanspaces.com
DO_SPACES_ENDPOINT=
# CDN endpoint: https://<bucket>.<region>.cdn.digitaloceanspaces.com
# Serving from the CDN rather than the origin is the whole point of using it.
DO_SPACES_CDN_ENDPOINT=

# --- Branding -----------------------------------------------------------
# The product name is NOT final. Nothing hard-codes it; change it here and
# run `php artisan config:clear` to rename the product everywhere.
BRAND_NAME="Temple Passport"
BRAND_TAGLINE="Your digital pilgrimage companion"
BRAND_URL="${APP_URL}"
BRAND_SUPPORT_EMAIL=support@example.com

# --- First admin account ------------------------------------------------
# Read once by `php artisan db:seed`. Leave ADMIN_PASSWORD blank and the
# seeder generates a strong one and prints it a single time.
# Remove these lines once the account exists.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
