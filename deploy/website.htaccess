# darshansaathi.com: the devotees' website.
#
# Copy this file to public_html/.htaccess (beside the laravel/ folder).
# Every page of the website (the home page, the temple, state and deity
# pages, the policy pages, the sitemap) is rendered by the Laravel project
# in public_html/laravel, which also answers as temple.darshansaathi.com
# (document root laravel/public). Nothing else in public_html is served.

# temple.darshansaathi.com (the admin panel, temple portal and API) lives
# inside this folder, at laravel/public, and some servers (LiteSpeed on
# Hostinger among them) apply this file to it as well. So everything here
# is either harmless there or limited to darshansaathi.com by the host
# check below; otherwise /admin would redirect to itself and the admin's
# sign-in would never load. Every address on the website goes to Laravel
# through the rules below, so no DirectoryIndex or ErrorDocument is set.
Options -Indexes

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

RewriteEngine On

# Any other host (temple.darshansaathi.com reading this file from its
# parent folder): none of these rules are for it.
RewriteCond %{HTTP_HOST} !^(www\.)?darshansaathi\.com$ [NC]
RewriteRule ^ - [L]

# A request this file already handed to laravel/public: done (on servers
# that apply this file there too, it would otherwise go round again).
RewriteCond %{ENV:REDIRECT_STATUS} .
RewriteRule ^ - [L]

# One address per page: www.darshansaathi.com moves to darshansaathi.com,
# so search engines do not split a temple's ranking between two copies.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Nothing of the Laravel project is reachable by its folder name.
RewriteCond %{THE_REQUEST} \s/+laravel(/|\s|\?) [NC]
RewriteRule ^ - [R=404,L]

# The admin panel, temple portal, API and QR pages live on
# temple.darshansaathi.com; one address each.
RewriteRule ^(admin|temple|api|livewire|pay|bookings|passport|qr)(/.*)?$ https://temple.darshansaathi.com/$1$2 [R=301,L]

# Addresses ending in / move to the same address without it.
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# The Laravel project's own files, as they are: the icon, the share card,
# the logo, the stylesheets, and the temple photos in storage/ (an address
# with no file there goes on to Laravel, which answers it or 404s).
RewriteRule ^(favicon\.(png|ico)|og\.png|(icons|brand|css|js|fonts|storage)/.+)$ laravel/public/$1 [L]

# Every other address is a page: Laravel renders it.
RewriteRule ^ laravel/public/index.php [L,QSA]
